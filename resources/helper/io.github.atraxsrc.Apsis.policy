<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  polkit actions checked by apsis-helper. Installed by `just install` to
  /usr/share/polkit-1/actions/. The messages are what the password dialog shows.
-->
<policyconfig>
  <vendor>Apsis</vendor>
  <vendor_url>https://github.com/atraxsrc/apsis</vendor_url>
  <icon_name>io.github.atraxsrc.Apsis</icon_name>

  <action id="io.github.atraxsrc.Apsis.list">
    <description>List system snapshots</description>
    <message>Apsis needs permission to list system snapshots</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.atraxsrc.Apsis.create">
    <description>Create a system snapshot</description>
    <message>Apsis needs your password to create a system snapshot</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.atraxsrc.Apsis.delete">
    <description>Delete a system snapshot</description>
    <message>Apsis needs your password to delete a system snapshot</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.atraxsrc.Apsis.configure">
    <description>Change the system snapshot settings</description>
    <message>Apsis needs your password to change the snapshot settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- File-level restore (Phase 6a). Snapshots hold root-only files, so browsing asks too. -->
  <action id="io.github.atraxsrc.Apsis.browse">
    <description>Browse the files in a system snapshot</description>
    <message>Apsis needs your password to browse the files in a system snapshot</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.atraxsrc.Apsis.restore">
    <description>Copy files from a system snapshot into your home folder</description>
    <message>Apsis needs your password to copy files from a system snapshot into your home folder</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- Asked every time: this replaces files on the running system. -->
  <action id="io.github.atraxsrc.Apsis.restore-original">
    <description>Put files from a system snapshot back in their original places</description>
    <message>Apsis needs your password to put files from a system snapshot back in their original places</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
