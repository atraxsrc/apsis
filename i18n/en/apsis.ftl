preparing-ready = Preparing restore · ready
restore-ready-elsewhere = Restore ready in another window
stop-restore-title = Stop the restore?
stop-restore-body = The safety snapshot being made is deleted. Nothing on the system has changed.
restore-stopped = Restore stopped
restore-failed = Restore failed: { $reason }
restore-failed-elsewhere = A restore started elsewhere failed
