{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gitleaks dir . --no-banner --redact)",
      "Bash(gitleaks git . --no-banner --redact)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(git config *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(sudo *)",
      "Bash(pkexec *)",
      "Bash(timeshift *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Read(~/.ssh/**)",
      "Read(~/.gitconfig)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
